<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ (API 31): bulut yedeği ve cihazdan cihaza aktarımda HİÇBİR
     uygulama verisi taşınmaz. Sohbet, AI hafızası ve oturum anahtarı cihazda
     kalır. Güvenlik denetimi M-5. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
