<?xml version="1.0" encoding="utf-8"?>
<!-- Android 11 ve öncesi: allowBackup=false yedeği zaten kapatıyor; bu dosya
     bir üretici yedeği yine de açarsa hiçbir alanın dahil edilmemesi için.
     Güvenlik denetimi M-5. -->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
