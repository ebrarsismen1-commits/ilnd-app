# Kopyala: cp .env.example .env, sonra gerçek Supabase URL'ini gir.
SUPABASE_URL=https://xxxx.supabase.co

# RevenueCat "secret" (v1) API anahtarı — RevenueCat Dashboard > Project
# Settings > API keys > Secret key. İSTEĞE BAĞLI ama mağaza aboneliği
# canlıya alınmadan ÖNCE girilmeli: anthropicProxy, hesabın haftalık ücretsiz
# kotasını aşan çağrılarda "bu hesap gerçekten abone mi?" sorusunu buradan
# doğrular. Anahtar yoksa yalnızca sunucunun kendi yazdığı ödül premium'u
# (referral) bilinir ve gerçek aboneler ücretsiz katman sınırına takılır.
# Not: istemcinin Purchases.logIn(uid) çağırması şart (bkz.
# RevenueCatService.identify) — aksi halde abonelik anonim bir app_user_id'ye
# bağlanır ve uid ile bulunamaz.
REVENUECAT_SECRET_KEY=sk_xxx

# App Check doğrulama modu (functions/appCheck.js): off | monitor | enforce.
# Boşsa monitor: doğrular ve loglar, reddetmez. Cloud Logging'deki
# {"event":"app_check","status":"missing|invalid"} oranı yeterince düşünce
# enforce'a alın. Tanınmayan değer enforce sayılır.
APP_CHECK_MODE=monitor

# Tarayıcıdan çağrıya izin verilen kaynaklar (virgülle ayrılmış). Boşsa
# Firebase Hosting alan adları + localhost. Özel alan adı eklenince buraya
# yazılmalı, yoksa web uygulaması fonksiyonlara ulaşamaz. Mobil uygulama
# etkilenmez (Origin göndermez).
# ALLOWED_ORIGINS=https://ilnd-app-8dcbd.web.app,https://ilnd.example
