{
  "name": "ilnd-functions",
  "description": "Supabase -> Firebase Auth bridge for ILND",
  "engines": {
    "node": "22"
  },
  "main": "index.js",
  "private": true,
  "scripts": {
    "deploy": "echo 'No default target. Use: npm run deploy:prod, or firebase deploy --only functions --project <alias>' && exit 1",
    "deploy:prod": "firebase deploy --only functions --project prod",
    "logs": "firebase functions:log --project prod",
    "test": "jest --runInBand",
    "seed:articles": "node scripts/seedArticles.js",
    "seed:movement": "node scripts/seedMovementPrograms.js",
    "seed:plans": "node scripts/seedPlans.js",
    "check:plans": "node scripts/checkPlans.js",
    "report:tokens": "node scripts/tokenReport.js",
    "backfill:counters": "node scripts/backfillCounters.js"
  },
  "dependencies": {
    "firebase-admin": "^13.10.0",
    "firebase-functions": "^7.3.2",
    "jose": "^6.2.12"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "firebase": "^12.19.0",
    "firebase-functions-test": "^3.4.0",
    "jest": "^29.7.0",
    "node-mocks-http": "^1.16.0"
  }
}
