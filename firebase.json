{
  "hosting": {
    "public": "build/web",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "headers": [
      {
        "//": "Flutter web'in bu dosyalarinin adinda icerik ozeti (hash) YOK — Hosting varsayilani onlari 1 saat onbellege aliyor ve deploy sonrasi kullanici eski surumu goruyor. Yazi tipi degisikligi tam olarak boyle 'uygulanmamis' gibi gorundu (2026-08-14). must-revalidate: tarayici her acilista sunucuya sorar, degismediyse 304 alir — maliyet yok.",
        "source": "/@(main.dart.js|flutter_bootstrap.js|flutter_service_worker.js|index.html|manifest.json)",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache, must-revalidate" }
        ]
      },
      {
        "//": "Varlıklar (fontlar, canvaskit) icerik-adresli, uzun onbellek guvenli.",
        "source": "/assets/**",
        "headers": [
          { "key": "Cache-Control", "value": "public, max-age=604800" }
        ]
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ]
    }
  ],
  "emulators": {
    "auth": {
      "port": 9099
    },
    "firestore": {
      "port": 8080
    },
    "functions": {
      "port": 5001
    },
    "storage": {
      "port": 9199
    },
    "ui": {
      "enabled": true,
      "port": 4000
    },
    "singleProjectMode": true
  }
}
