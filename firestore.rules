rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Kullanıcılar sadece kendi verilerine erişebilir
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Makaleler herkese açık (okuma), yazma sadece admin
    match /articles/{articleId} {
      allow read: if true;
      allow write: if false; // Admin SDK ile yazılır
    }

    // Referral kodları — okuma tüm authenticated kullanıcılara açık (kod
    // çözümleme ve sayaç/istatistik için). Yazma SADECE doküman sahibinin
    // kendi başlangıç dokümanını (referral_code) oluşturmasına izin verir;
    // founding_member / premium_access_until / referred_by_code alanları
    // create sonrası ASLA client tarafından değiştirilemez — bunlar yalnızca
    // functions/index.js'teki redeemReferralCode (Admin SDK, transaction)
    // tarafından yazılır. Önceki sürümde bu kural `allow write: if true`
    // idi ve herkes kendine sınırsız premium verebiliyordu (P0, kapatıldı).
    // Okuma SADECE kendi dokümanın: eskiden tüm girişli kullanıcılar bütün
    // koleksiyonu okuyabiliyordu — herkesin davet kodu ve "kimi kim davet
    // etti" grafiği dışarı sızıyordu (denetim bulgusu, 2026-07-24). Kod
    // çakışma kontrolü için gereken koleksiyon-geneli sorgu kaldırıldı;
    // yerine daha uzun (8 karakter) kod üretiliyor — bkz.
    // referral_repository.ensureReferralCode.
    match /user_growth/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.founding_member == false
        && request.resource.data.premium_access_until == null
        && request.resource.data.referred_by_code == null;
      allow update, delete: if false;
    }

    // Append-only referral kayıtları — sadece redeemReferralCode (Admin SDK)
    // yazar VE okur. İstemciye kapalı: hiçbir ekran bu koleksiyonu okumuyor,
    // açık bırakmak yalnızca sosyal grafiği (kim kimi davet etti) sızdırıyordu
    // (denetim bulgusu, 2026-07-24). Admin SDK kuralları baypas eder.
    match /referrals/{referralId} {
      allow read: if false;
      allow create, update, delete: if false;
    }

    // Alışkanlıklar ve tamamlama kayıtları — top-level koleksiyonlar
    // (users/{uid}/... değil), userId alanına göre sahiplik kontrolü.
    // ÖNEMLİ: bu koleksiyonlar için önceden HİÇ rule yoktu — Firestore'un
    // varsayılan deny-all'ı yüzünden takip ekranı production'da tamamen
    // permission-denied veriyordu. Bu, Phase 1 audit sırasında keşfedilen
    // ayrı bir fonksiyonel hataydı (bilinen güvenlik bulgularından biri
    // değil), düzeltildi.
    match /habits/{habitId} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid;
      allow update, delete: if request.auth != null
        && resource.data.userId == request.auth.uid;
    }

    match /habit_completions/{completionId} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid;
      allow update, delete: if request.auth != null
        && resource.data.userId == request.auth.uid;
    }

    // Etkinlikler (ADR-0002): içerik yalnız seed script'ten (Admin SDK)
    // gelir — articles deseninin simetriği. RSVP: kullanıcı yalnız KENDİ
    // kaydını (doc id == uid) oluşturur/siler; sayım aggregate count() ile.
    match /events/{eventId} {
      allow read: if request.auth != null;
      allow write: if false; // Admin SDK ile yazılır

      match /rsvps/{userId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null
          && request.auth.uid == userId
          && request.resource.data.userId == userId;
        allow delete: if request.auth != null && request.auth.uid == userId;
        allow update: if false;
      }
    }

    // AI kullanım sayaçları (günlük kademe tavanı + haftalık ücretsiz kota).
    // YAZMA HERKESE KAPALI: bu dokümanları yalnız functions/index.js'teki
    // anthropicProxy (Admin SDK, kurallardan muaf) yazar. Sayaç hesap bazlı
    // olduğu için (uid'e bağlı, cihaza değil) istemcinin yazabilmesi tüm
    // sınırı anlamsız kılardı — kullanıcı kendi sayacını sıfırlardı.
    // OKUMA yalnız kendi dokümanların: uygulama kalan hakkı gösterebilsin ve
    // limit dolduğunda çağrı yapmadan paywall açabilsin diye. ÖNEMLİ: bu
    // koleksiyon users/{uid} ALTINDA DEĞİL — orası sahibine tam yazma izni
    // veriyor ve Firestore'da daha dar bir kural geniş olanı geçersiz kılmaz.
    // `resource == null` şartı ŞART: haftanın ilk çağrısı yapılmadan sayaç
    // dokümanı yoktur ve var-olmayan dokümanda resource.data okumak kuralı
    // hataya düşürüp permission-denied verir. Dinleyici o hatadan sonra
    // kendini yenilemez (bkz. Bilinen Tuzaklar) — yani sayaç tüm hafta boyu
    // sessizce ölü kalırdı. Boş doküman okumak hiçbir şey sızdırmaz.
    match /ai_usage/{usageId} {
      allow read: if request.auth != null
        && (resource == null || resource.data.uid == request.auth.uid);
      allow write: if false;
    }

    // Sosyal kanıt sayacı için anonim, kullanıcı başına günde tek doküman.
    // Toplam aktif kullanıcı sayısını saymak için herkes (authenticated)
    // okuyabilir; her kullanıcı sadece kendi kaydını yazabilir.
    // Doküman kimliği ZORUNLU olarak "{uid}_{tarih}" — eskiden yalnız userId
    // alanına bakılıyordu, bu yüzden herhangi bir kullanıcı istediği id'yle
    // sınırsız kayıt üretip sayacı şişirebiliyordu (denetim bulgusu,
    // 2026-07-24). Kimlik sabitlenince kullanıcı-gün başına tek kayıt kalır.
    match /daily_checkins/{checkinId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && request.resource.data.userId == request.auth.uid
        && checkinId == request.auth.uid + '_' + request.resource.data.date;
      allow delete: if false;
    }
  }
}
