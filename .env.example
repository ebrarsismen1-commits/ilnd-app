# Build komutu: flutter run --dart-define-from-file=.env
# Bu dosyayi kopyala: cp .env.example .env  (veya .env.example'i doldur ve .env olarak kaydet)

FIREBASE_API_KEY=AIza
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_STORAGE_BUCKET=your-project.appspot.com
FIREBASE_MESSAGING_SENDER_ID=123456789
FIREBASE_APP_ID=1:123456789:android:abc123
GOOGLE_SERVER_CLIENT_ID=123456789-xxxx.apps.googleusercontent.com
REVENUECAT_API_KEY=appl_
# Cloud Functions tabanı (sonunda / olabilir). Eski .env'lerdeki AUTH_BRIDGE_URL
# de okunur (tabanı ondan türetilir), ama köprü kalktı: yenisine geçin.
FUNCTIONS_BASE_URL=https://us-central1-your-project-id.cloudfunctions.net/
